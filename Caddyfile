# Caddyfile for Jiddat3D
# Serves static assets and reverse proxies dynamic routes, API, and Admin UI to PocketBase.

{
	email info@jiddat3d.com
}

jiddat3d.com, www.jiddat3d.com {
	# Serve /static directly from /app/ui/static
	handle_path /static/* {
		root * /app/ui/static
		file_server
	}

	# Reverse proxy API, Admin UI, and dynamic Go pages to PocketBase (port 8090)
	handle {
		reverse_proxy localhost:8090
	}

	# Enable compression
	encode gzip zstd
}
